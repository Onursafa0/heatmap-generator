{
  "name": "heatmap-generator",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "deploy:gh": "ng build --base-href /heatmap-generator/ && ngh --dir=dist/heatmap-generator/browser",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently \"npm run start\" \"wait-on http://localhost:4200 && electron electron/main.js\"",
    "electron:build": "npm run build && electron electron/main.js",
    "electron:pack": "npm run build && electron-packager . HeatmapGenerator --platform=win32 --arch=x64 --out=dist-electron --overwrite --ignore=node_modules/.* --ignore=src --ignore=.git --ignore=dist-electron",
    "build:portable": "npm run build && electron-builder --win portable"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "build": {
    "appId": "com.heatmap.generator",
    "productName": "Heatmap Generator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/heatmap-generator/browser/browser/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": "portable",
      "artifactName": "Heatmap Generator.exe",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "publish": []
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.1.7",
    "echarts": "^6.0.0",
    "jspdf": "^3.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.4",
    "@angular/cli": "^20.0.4",
    "@angular/compiler-cli": "^20.0.0",
    "angular-cli-ghpages": "^2.0.3",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.4"
  }
}